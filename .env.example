# Copy this file to .env, then set your local MySQL username and password.
SECRET_KEY=replace-with-a-long-random-secret
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DB=netmap_db

# Set to 1 only for local debugging. Leave at 0 otherwise.
FLASK_DEBUG=0

# Set to 1 in production (HTTPS only). Leave at 0 for local HTTP development.
# render.yaml sets this to 1 automatically for Render deployments.
SESSION_COOKIE_SECURE=0
